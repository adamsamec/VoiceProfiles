#. Translators: Switch to the next voice profile gesture description for the Input gestures settings dialog
#: addon\globalPlugins\voiceProfiles\__init__.py:35
msgid "Switches to the next voice profile"
msgstr "Prepne na nasledujúci hlasový profil"

#. Translators: Switch to the previous voice profile gesture description for the Input gestures settings dialog
#: addon\globalPlugins\voiceProfiles\__init__.py:43
msgid "Switches to the previous voice profile"
msgstr "Prepne na predchádzajúci hlasový profil"

#. Translators: Select a voice profile gesture description for the Input gestures settings dialog
#: addon\globalPlugins\voiceProfiles\__init__.py:51
msgid "Shows the dialog for selecting a voice profile"
msgstr "Zobrazí dialóg pre výber hlasového profilu"

#. Constants
#. Translators: Label for the silence synthesizer in the voices listbox or synthesizers and voices comboboxes
#: addon\globalPlugins\voiceProfiles\consts.py:10
msgid "Silence"
msgstr "Bez reči"

#: addon\globalPlugins\voiceProfiles\selectVoiceProfileDialog.py:25
msgid "Select a voice profile"
msgstr "Vyberte hlasový profil"

#. Translators: Label for the voice profiles listbox in the Select a voice dialog
#. Translators: Label for the voice profiles listbox in the add-on settings
#: addon\globalPlugins\voiceProfiles\selectVoiceProfileDialog.py:40
#: addon\globalPlugins\voiceProfiles\settingsDialogs.py:49
msgid "Voice profiles"
msgstr "Hlasové profily"

#. Translators: Label for the OK button in the select a voice dialog
#: addon\globalPlugins\voiceProfiles\selectVoiceProfileDialog.py:47
msgid "OK"
msgstr "OK"

#. Translators: Label for the cancel button in the select voice dialog
#. Translators: Label for the cancel button in the add voice profile dialog
#. Translators: Label for the cancel button in the edit voice profile dialog
#: addon\globalPlugins\voiceProfiles\selectVoiceProfileDialog.py:52
#: addon\globalPlugins\voiceProfiles\settingsDialogs.py:171
#: addon\globalPlugins\voiceProfiles\settingsDialogs.py:294
msgid "Cancel"
msgstr "Zrušiť"

#. Translators: Add-on settings panel title
#. Add-on summary, usually the user visible name of the addon.
#. Translators: Summary for this add-on
#. to be shown on installation and add-on information found in Add-ons Manager.
#: addon\globalPlugins\voiceProfiles\settingsDialogs.py:21 buildVars.py:23
msgid "Voice Profiles"
msgstr "Voice Profiles"

#. Translators: Label for the add button in the add-on settings
#. Translators: Label for the add button in the add voice profile dialog
#: addon\globalPlugins\voiceProfiles\settingsDialogs.py:56
#: addon\globalPlugins\voiceProfiles\settingsDialogs.py:166
msgid "Add"
msgstr "Pridať"

#. Translators: Label for the edit button in the add-on settings
#: addon\globalPlugins\voiceProfiles\settingsDialogs.py:60
msgid "Edit"
msgstr "Upraviť"

#. Translators: Label for the remove button in the add-on settings
#: addon\globalPlugins\voiceProfiles\settingsDialogs.py:64
msgid "Remove"
msgstr "Odstrániť"

#. Translators: Label for the update voice when NVDA's own speech settings change checkbox in the add-on settings
#: addon\globalPlugins\voiceProfiles\settingsDialogs.py:71
msgid "Update voice when NVDA's own speech settings change"
msgstr "Aktualizovať hlas pri jeho zmene cez nastavenie reči samotného NVDA"

#: addon\globalPlugins\voiceProfiles\settingsDialogs.py:107
msgid "The last remaining voice profile cannot be removed"
msgstr "Posledný zostávajúci hlas nie je možné odstrániť"

#: addon\globalPlugins\voiceProfiles\settingsDialogs.py:132
msgid "Add a voice profile"
msgstr "Pridať hlasový profil"

#. Translators: Label for the synthesizers combobox in the add voice profile dialog
#. Translators: Label for the synthesizers combobox in the edit voice profile dialog
#: addon\globalPlugins\voiceProfiles\settingsDialogs.py:149
#: addon\globalPlugins\voiceProfiles\settingsDialogs.py:267
msgid "Synthesizer"
msgstr "Hlasový výstup"

#. Translators: Label for the voices combobox in the add voice profile dialog
#. Translators: Label for the voices combobox in the edit voice profile dialog
#: addon\globalPlugins\voiceProfiles\settingsDialogs.py:155
#: addon\globalPlugins\voiceProfiles\settingsDialogs.py:277
msgid "Voice"
msgstr "Hlas"

#. Translators: Label for the profile name text field in the add voice profile dialog
#. Translators: Label for the profile name text field in the edit voice profile dialog
#: addon\globalPlugins\voiceProfiles\settingsDialogs.py:159
#: addon\globalPlugins\voiceProfiles\settingsDialogs.py:281
msgid "Profile name"
msgstr "Názov profilu"

#. Translators: Value of the voices combobox in the add voice dialog when no voices are available
#. Translators: Value of the voices combobox in the edit voice dialog when no voices are available
#: addon\globalPlugins\voiceProfiles\settingsDialogs.py:206
#: addon\globalPlugins\voiceProfiles\settingsDialogs.py:333
msgid "No voices available"
msgstr "Žiadne hlasy nie sú dostupné"

#: addon\globalPlugins\voiceProfiles\settingsDialogs.py:248
msgid "Edit voice profile"
msgstr "Upraviť hlasový profil"

#. Translators: Label for the save button in the edit voice profile dialog
#: addon\globalPlugins\voiceProfiles\settingsDialogs.py:289
msgid "Save"
msgstr "Uložiť"

#. Translators: Default profile name for unknown voice
#: addon\globalPlugins\voiceProfiles\voiceProfiles.py:338
msgid "Unknown"
msgstr "Neznámy"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-ons manager
#: buildVars.py:26
msgid "Allows creation of voice profiles and easy switching between them."
msgstr "Umožňuje vytváranie hlasových profilov a ľahké prepínanie medzi nimi."
